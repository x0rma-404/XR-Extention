{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "XR",
    "scopeName": "source.xr",

    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#lists"
        },
        {
            "include": "#keywords"
        },
        {
            "include": "#builtins"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#variables"
        }
    ],

    "repository": {

        "comments": {
            "patterns": [
                {
                    "name": "comment.line.double-slash.xr",
                    "match": "//.*$"
                }
            ]
        },

        "strings": {
            "name": "string.quoted.single.xr",
            "begin": "'",
            "end": "'",
            "patterns": [
                {
                    "name": "constant.character.escape.xr",
                    "match": "\\\\."
                }
            ]
        },

        "lists": {
            "name": "meta.list.xr",
            "begin": "#\\[",
            "end": "\\]",
            "patterns": [
                {
                    "include": "#strings"
                },
                {
                    "include": "#numbers"
                },
                {
                    "include": "#comments"
                }
            ]
        },

        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.conditional.xr",
                    "match": "\\?"
                },
                {
                    "name": "keyword.control.loop.xr",
                    "match": "@"
                },
                {
                    "name": "keyword.control.declaration.xr",
                    "match": "\\bdeyer\\b"
                },
                {
                    "name": "keyword.control.else.xr",
                    "match": "\\:"
                }
            ]
        },

        "builtins": {
            "patterns": [
                {
                    "name": "support.function.builtin.xr",
                    "match": "\\b(uz|qat|cixar|metn|eded|sirala|boyuk|kicik|bol|yig|var)\\b"
                }
            ]
        },

        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.assignment.xr",
                    "match": "->"
                },
                {
                    "name": "keyword.operator.comparison.xr",
                    "match": "<>|<=|>=|="
                },
                {
                    "name": "keyword.operator.logical.xr",
                    "match": "&|\\||!"
                },
                {
                    "name": "keyword.operator.arithmetic.xr",
                    "match": "\\+|-|\\*|/|%"
                },
                {
                    "name": "keyword.operator.power.xr",
                    "match": "\\^"
                },
                {
                    "name": "keyword.operator.concat.xr",
                    "match": "~"
                },
                {
                    "name": "keyword.operator.output.xr",
                    "match": ">"
                },
                {
                    "name": "keyword.operator.range.xr",
                    "match": "\\.\\."
                },
                {
                    "name": "keyword.operator.index.xr",
                    "match": "\\."
                }
            ]
        },

        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.range.xr",
                    "match": "\\b\\d+\\.\\.\\d+\\b"
                },
                {
                    "name": "constant.numeric.float.xr",
                    "match": "\\b\\d+\\.\\d+\\b"
                },
                {
                    "name": "constant.numeric.integer.xr",
                    "match": "\\b\\d+\\b"
                }
            ]
        },

        "variables": {
            "patterns": [
                {
                    "name": "variable.other.xr",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
                }
            ]
        }
    }
}