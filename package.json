{
    "name": "xr",
    "displayName": "XR Language Support",
    "description": "Language support for the XR programming language",
    "version": "0.0.1",

    "icon": "XR.jpg",

    "repository": {
        "type": "git",
        "url": "https://github.com/x0rma-404/XR.git"
    },

    "engines": {
        "vscode": "^1.138.0"
    },

    "categories": [
        "Programming Languages"
    ],

    "main": "./extension.js",

    "activationEvents": [
        "onLanguage:xr",
        "onCommand:xr.runFile"
    ],

    "contributes": {
        "languages": [
            {
                "id": "xr",
                "aliases": [
                    "XR",
                    "xr"
                ],
                "extensions": [
                    ".xr"
                ],
                "configuration": "./language-configuration.json"
            }
        ],

        "grammars": [
            {
                "language": "xr",
                "scopeName": "source.xr",
                "path": "./syntaxes/xr.tmLanguage.json"
            }
        ],

        "commands": [
            {
                "command": "xr.runFile",
                "title": "XR: Run File"
            }
        ],

        "snippets": [
            {
                "language": "xr",
                "path": "./snippets/xr.json"
            }
        ],

        "iconThemes": [
            {
                "id": "xr-icons",
                "label": "XR Icons",
                "path": "./xr-icon-theme.json"
            }
        ]
    }
}